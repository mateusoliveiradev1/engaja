# Root development environment template.
# Copy to .env locally and replace placeholders with private values.

APP_ENV=development
COST_GUARDRAILS_ENABLED=true
ALLOW_METERED_PROVIDERS=false

# Public URLs. Expo reads only EXPO_PUBLIC_* values.
API_PUBLIC_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ENABLE_DEMO_FALLBACK=false

# Server-only database settings.
DATABASE_PROVIDER=local-postgres
DATABASE_URL=postgresql://engaja:engaja@localhost:5432/engaja
NEON_DATABASE_URL=

# Server-only auth/session/invite settings.
AUTH_PROVIDER=local-better-auth
AUTH_LOCAL_SECRET=replace-with-local-dev-value
SESSION_SECRET=replace-with-local-dev-value
INVITE_TOKEN_SECRET=replace-with-local-dev-value

# Server-only storage and integrations.
STORAGE_PROVIDER=local-filesystem
LOCAL_STORAGE_DIR=.local/storage
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
EMAIL_PROVIDER=console
ANALYTICS_PROVIDER=local-log
CI_PROVIDER=local
BUILD_PROVIDER=expo-local
MONITORING_PROVIDER=local-log
